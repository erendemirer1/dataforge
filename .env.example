# ==============================================================================
# DataForge Environment Variables Configuration
# ==============================================================================

# Google Gemini API Key (Optional)
# If provided, enables live multi-model LLM inference failover (gemini-3.5-flash / gemini-3.1-flash-lite / gemini-3.6-flash).
# If left blank, DataForge automatically defaults to its built-in local Causal Deterministic Engine (Zero cost, 100% offline).
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
